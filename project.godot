[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lightmapping/lightmap_gi/use_bicubic_filter=false
environment/defaults/default_clear_color=Color(0.015, 0.018, 0.025, 1)
lightmapping/bake_performance/region_size=128
lightmapping/bake_performance/max_rays_per_probe_pass=16

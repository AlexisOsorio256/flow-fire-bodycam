.godot/
__pycache__/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
# Material de trabajo: capturas (Godot no las importa por su .gdignore).
captures/*
!captures/.gdignore
# Godot extrae estas imagenes del propio fps_arms.glb al importarlo.
assets/models/fps_arms_arms_*.png
assets/models/fps_arms_arms_*.png.import
assets/models/factory_*
assets/models/muelle_*
assets/models/nave_*
# Godot extrae estas imagenes de cada .glb al importarlo (mismo caso que fps_arms).
assets/models/enemy_*.png
assets/models/enemy_*.png.import
assets/models/ar15_*.png
assets/models/ar15_*.png.import
assets/models/g19_*.png
assets/models/g19_*.png.import
assets/models/*.unwrap_cache
*.blend1
build/
# Texturas de la G19 y del enemigo: el juego las carga en runtime, van en git.
!assets/models/g19_pistol_Image_*.png
!assets/models/g19_pistol_Image_*.png.import
!assets/models/enemy_g19_pistol_Image_3.png
!assets/models/enemy_g19_pistol_Image_3.png.import
